pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "gobiit/my-django-app"
        DOCKER_TAG = "latest"
        DOCKER_CREDENTIALS_ID = "docker-hub-credentials-id"
        JAVA_HOME = "/usr/lib/jvm/java-17-openjdk-amd64"  // Add this line
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Checkout your Git repository
                git 'https://github.com/janushanth/Kubernetes_projects.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Build the Docker image from the current directory (or specify the correct folder)
                    docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}", ".")
                }
            }
        }

        stage('Login to Docker Hub') {
            steps {
                script {
                    // Login to Docker Hub using Jenkins credentials
                    withCredentials([usernamePassword(credentialsId: DOCKER_CREDENTIALS_ID, passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        sh """
                            echo \$DOCKER_PASSWORD | docker login --username \$DOCKER_USERNAME --password-stdin
                        """
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    // Push the Docker image to Docker Hub
                    docker.push("${DOCKER_IMAGE}:${DOCKER_TAG}")
                }
            }
        }
    }

    post {
        always {
            // Clean up Docker images (optional)
            sh 'docker system prune -f'
        }
    }
}
y